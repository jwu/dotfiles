{{- /* Keys synced into an existing ~/.pi/agent/settings.json by
       run_after_55-pi-settings-sync.sh.tmpl: extensions, packages, defaultTools, theme,
       tuiMode, quietStartup, enableInstallTelemetry, defaultProjectTrust, hideThinkingBlock.
       The rest is the baseline for a machine with no settings.json yet.
       The built-in MCP extension stays enabled (no `-builtin:mcp`): pi-mcp-adapter was removed
       in favor of it, and the servers live in ~/.pi/agent/mcp.json (source: create_mcp.json).
       See docs/design.md. */ -}}
{
  "shellCommandPrefix": "python(){ uv run python \"$@\"; }\npython3(){ uv run python \"$@\"; }\nexport -f python\nexport -f python3",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "theme": "one-dark",
  "tuiMode": "fullscreen",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "extensions": [
{{- if eq .chezmoi.os "windows" }}
    "c:/bin/pi-config/extensions"
{{- else }}
    "~/bin/pi-config/extensions"
{{- end }}
  ],
  "packages": [
    "npm:@johnnywu/pi-ask",
    "npm:@johnnywu/pi-filechanges",
    "npm:@johnnywu/pi-image-gen",
    "npm:@johnnywu/pi-subagents",
    "npm:@johnnywu/pi-webfetch",
    "npm:pi-animations",
    "npm:pi-powerline",
    "npm:pi-stats-ext",
    "npm:@juicesharp/rpiv-todo"
  ],
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls",
    "codemode"
  ],
  "hideThinkingBlock": false
}
