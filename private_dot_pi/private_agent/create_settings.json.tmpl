{{- /* Keys synced into an existing ~/.pi/agent/settings.json by
       run_after_55-pi-settings-sync.sh.tmpl: $schema, extensions, packages, defaultTools,
       theme, tuiMode, quietStartup, enableInstallTelemetry, defaultProjectTrust,
       hideThinkingBlock.
       The rest is the baseline for a machine with no settings.json yet.
       The built-in MCP extension stays enabled (no `-builtin:mcp`): pi-mcp-adapter was removed
       in favor of it, and the servers live in ~/.pi/agent/mcp.json (source: create_mcp.json).
       See docs/design.md. */ -}}
{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "shellCommandPrefix": "python(){ uv run python \"$@\"; }\npython3(){ uv run python \"$@\"; }\nexport -f python\nexport -f python3",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "magpie/codex/gpt-6-astra": "medium",
    "magpie/codex/gpt-6.1-sol": "medium",
    "magpie/codex/gpt-6.1-terra": "medium",
    "magpie/codex/gpt-6.2-astra": "medium",
    "magpie/codex/gpt-6.2-sol": "medium",
    "magpie/deepseek/deepseek-flash": "high",
    "magpie/hostinger-vps-us/claude/claude-fable-5-2": "high",
    "magpie/hostinger-vps-us/claude/claude-haiku-5-5": "medium",
    "magpie/hostinger-vps-us/claude/claude-opus-5-5": "medium",
    "magpie/hostinger-vps-us/claude/claude-sonnet-5-5": "high",
    "magpie/kimi-code-cn/k3.1-pro": "max",
    "magpie/kimi-code-cn/k3.1-pro-highspeed": "max",
    "magpie/xai/grok-4.7": "high"
  },
  "theme": "one-dark",
  "tuiMode": "fullscreen",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "extensions": [],
  "packages": [
    "npm:@johnnywu/pi-ask",
    "npm:@johnnywu/pi-config",
    "npm:@johnnywu/pi-filechanges",
    "npm:@johnnywu/pi-herdr-agents",
    "npm:@johnnywu/pi-image-gen",
    "npm:@johnnywu/pi-subagents",
    "npm:@johnnywu/pi-webfetch",
    "npm:pi-animations",
    "npm:pi-powerline",
    "npm:pi-stats-ext",
    "npm:@juicesharp/rpiv-todo"
  ],
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls",
    "codemode"
  ],
  "hideThinkingBlock": false
}
