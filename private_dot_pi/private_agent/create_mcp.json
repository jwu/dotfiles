{
 "mcpServers": {
  "blender": {
   "command": "uvx",
   "args": [
    "blender-mcp"
   ],
   "directTools": false
  },
  "chrome-devtools": {
   "command": "npx",
   "args": [
    "-y",
    "chrome-devtools-mcp@latest",
    "--wsEndpoint",
    "ws://127.0.0.1:9222/devtools/browser/pi-agent"
   ]
  }
 },
 "settings": {
  "mcpFooterStatus": "compact"
 }
}
