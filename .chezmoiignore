# Files that belong to the repository itself, not to the chezmoi source.
#
# Patterns match *target* paths, not source paths: `README.md` here means
# ~/README.md, so without this line chezmoi would create that file.
# See docs/chezmoi-notes.md.
README.md
AGENTS.md
LICENSE
.gitignore
.gitattributes

# Docs and scripts: neither is a target.
docs
bootstrap
scripts

# Windows-only targets.
{{ if ne .chezmoi.os "windows" }}
AppData
.wezterm.lua
{{ end }}

# macOS-only targets.
{{ if ne .chezmoi.os "darwin" }}
.aerospace.toml
Library
.config/ghostty/config
# Input Source Pro is macOS-only; its exported settings are only the input to a
# one-off restore on a new Mac.
.config/inputsourcepro
{{ end }}

# Linux-only target: ghostty reads a different filename on each side.
{{ if ne .chezmoi.os "linux" }}
.config/ghostty/config.ghostty
{{ end }}

# Windows targets. Windows builds of these applications read %APPDATA% / %LOCALAPPDATA%
# instead of ~/.config, so the Unix copies would either duplicate the real target
# (nvim, alacritty, neovide) or land where nothing reads them (yazi, gitui, glow,
# zed). Their Windows paths live under AppData/.
# starship is the exception: it reads ~/.config/starship.toml on Windows too, so
# dot_config/starship.toml.tmpl stays one target for all three platforms.
{{ if eq .chezmoi.os "windows" }}
.zshrc
.config/alacritty
.config/ghostty
.config/gitui
.config/glow
.config/neovide
.config/nvim
.config/yazi
.config/zed
{{ end }}

# Linux-only targets. They are the source of truth on Linux, but hyprland /
# niri / waybar / swaylock / fcitx5 do not exist on macOS, the titlebar CSS only
# applies to the GTK build of ghostty, the *-flags.conf files are read by the
# Arch chrome / chromium wrappers, and mimeapps.list is XDG. fontconfig and
# voxtype are Linux-shaped as well: the first is loaded by /etc/fonts/fonts.conf
# and read by the chrome wrapper, the second by niri's evdev hotkey path.
# wireplumber is PipeWire's session manager and has no counterpart elsewhere.
# See docs/ghostty-titlebar.md, docs/fontconfig.md and docs/voxtype.md.
{{ if ne .chezmoi.os "linux" }}
.config/autostart
.config/chrome-flags.conf
.config/chromium-flags.conf
.config/environment.d
.config/fcitx5
.config/fontconfig
.config/gtk-4.0
.config/ghostty/titlebar.css
.config/ghostty/titlebar-colors-default.css
.config/ghostty/titlebar-colors-onedark.css
.config/ghostty/titlebar-colors-onedark-purple.css
.config/hypr
.config/mimeapps.list
.config/niri
.config/niri-session-mng
.config/sunshine
.config/swaylock
.config/voxtype
.config/waybar
.config/wireplumber
# Whole subtree: ignoring the files alone still makes chezmoi create the empty
# parent directories. See docs/chezmoi-notes.md.
.local
{{ end }}
