# 仓库自身的文件，不是 chezmoi 源。
#
# 这里的 pattern 匹配的是「目标路径」，不是源路径。所以 `README.md` 指的是
# 家目录下的 `~/README.md`——不加这一行的后果是 chezmoi apply 会真的在 ~ 下
# 创建 README.md。
README.md
AGENTS.md
LICENSE
.gitignore
.gitattributes

# 文档与脚本目录
docs
bootstrap
scripts

# Windows 专有目标
{{ if ne .chezmoi.os "windows" }}
AppData
{{ end }}

# macOS 专有目标
{{ if ne .chezmoi.os "darwin" }}
.aerospace.toml
Library
.config/ghostty/config
{{ end }}

# Linux 专有目标：ghostty 在两侧的目标文件名不同
{{ if ne .chezmoi.os "linux" }}
.config/ghostty/config.ghostty
{{ end }}

# Windows 上不部署 Unix shell 配置
{{ if eq .chezmoi.os "windows" }}
.zshrc
.config/starship.toml
{{ end }}
