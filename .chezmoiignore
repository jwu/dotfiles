# 仓库自身的文件，不是 chezmoi 源。
#
# 这里的 pattern 匹配的是「目标路径」，不是源路径。所以 `README.md` 指的是
# 家目录下的 `~/README.md`——不加这一行的后果是 chezmoi apply 会真的在 ~ 下
# 创建 README.md。
README.md
AGENTS.md
LICENSE
.gitignore
.gitattributes

# 文档、脚本与 Windows 装机层（都不是 chezmoi 源）
docs
bootstrap
scripts
win

# Windows 专有目标
{{ if ne .chezmoi.os "windows" }}
AppData
.wezterm.lua
{{ end }}

# macOS 专有目标
{{ if ne .chezmoi.os "darwin" }}
.aerospace.toml
Library
.config/ghostty/config
{{ end }}

# Linux 专有目标：ghostty 在两侧的目标文件名不同
{{ if ne .chezmoi.os "linux" }}
.config/ghostty/config.ghostty
{{ end }}

# Windows 上不部署 Unix shell 配置
{{ if eq .chezmoi.os "windows" }}
.zshrc
.config/starship.toml
{{ end }}

# Linux 专有目标。它们是 Linux 机器上的真源，但 macOS 上 hyprland / niri / waybar /
# swaylock / fcitx5 都不存在，GTK 标题栏 CSS 更是只对 Linux 的 GTK 版 Ghostty 有意义
# （见 docs/ghostty-titlebar.md）。不排除的话，apply 会在 macOS 家目录里铺一整套
# Linux 配置，包括 6 张壁纸和三个 niri-* 脚本。
{{ if ne .chezmoi.os "linux" }}
.config/autostart
.config/environment.d
.config/fcitx5
.config/gtk-4.0
.config/ghostty/titlebar.css
.config/ghostty/titlebar-colors-default.css
.config/ghostty/titlebar-colors-onedark.css
.config/ghostty/titlebar-colors-onedark-purple.css
.config/hypr
.config/niri
.config/swaylock
.config/waybar
# ~/.local 下源里的一切都是 Linux 专有（三个 niri-* 脚本、fcitx5 的 rime 配置与
# 主题、图标、neovide.desktop），所以整棵子树都不部署。逐个文件排除是不够的：
# 那样 chezmoi 仍会为了空的父目录而创建 ~/.local/share/applications。
.local
{{ end }}
