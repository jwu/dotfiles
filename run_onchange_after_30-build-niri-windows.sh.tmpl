{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Builds the niri minimap CFFI module from our fork of
# calico32/waybar-niri-windows. Always from source: upstream's prebuilt asset
# would silently drop the fixes that live only on the fork.
#
# run_onchange_ plus the helper hash below, so the trade-off is that it no longer
# follows the fork's HEAD by itself -- bump the helper to force a rebuild. The
# build details live in the sourced library. See docs/waybar.md.
#
# helper hash: {{ include "scripts/waybar-niri-windows.sh" | sha256sum }}
set -uo pipefail

{{ if ne .chezmoi.os "linux" -}}
# niri, waybar and Wayland are all Linux-only, and the CFFI module is never
# loaded without them. Same reasoning as the gpu-watch short-circuit: exit 0 so
# a script that cannot apply here does not abort the whole apply.
echo "not Linux; skipping the niri-windows module"
exit 0
{{ end }}
SRC="{{ .chezmoi.sourceDir }}"

if [ ! -f "$SRC/scripts/waybar-niri-windows.sh" ]; then
  echo "Missing $SRC/scripts/waybar-niri-windows.sh" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$SRC/scripts/waybar-niri-windows.sh"

want="$(wnmw_want_commit)"

if wnmw_is_installed "$want"; then
  echo "cffi/niri-windows module up to date (${want:0:7})"
  exit 0
fi

have="$(wnmw_stamp_commit)"
if [ -n "$have" ]; then
  echo "cffi/niri-windows module is stale: installed ${have:0:7}, fork main is ${want:0:7}"
else
  echo "cffi/niri-windows module has no version stamp"
fi

missing="$(wnmw_missing_tools)"
if [ -n "$missing" ]; then
  echo "Cannot rebuild without: $missing" >&2
  echo "Run 'chezmoi apply' again once the provisioning script has installed them." >&2
  exit 1
fi

if wnmw_build_and_install "$want"; then
  echo "Rebuilt cffi/niri-windows module at ${want:0:7}"
  wnmw_restart_hint
else
  echo "Rebuild failed; keeping the installed module (see docs/waybar.md)." >&2
  exit 1
fi
{{ end -}}
