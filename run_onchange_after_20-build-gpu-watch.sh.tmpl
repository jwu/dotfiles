#!/bin/bash
# Builds gpu-watch, which waybar's GPU modules call. dlopen means gcc is the only
# build dependency; the embedded hash makes run_onchange_ rebuild it only when
# gpu-watch.c changes. See docs/waybar.md.
#
# source hash: {{ include "scripts/gpu-watch.c" | sha256sum }}
set -euo pipefail

{{ if ne .chezmoi.os "linux" -}}
# gpu-watch reads NVIDIA GPU metrics through libnvidia-ml, opened with dlopen.
# Neither exists here, and macOS has no libdl either, so the gcc line below
# would fail and chezmoi would abort the whole apply on a script that can never
# succeed. Exit successfully instead of doing nothing.
echo "not Linux; skipping gpu-watch"
exit 0
{{ end }}
SRC="{{ .chezmoi.sourceDir }}"

if ! command -v gcc &> /dev/null; then
  echo "gcc is missing; skipping the gpu-watch build (the waybar GPU modules will show 'off')." >&2
  exit 1
fi

if [ ! -f "$SRC/scripts/gpu-watch.c" ]; then
  echo "Missing $SRC/scripts/gpu-watch.c" >&2
  exit 1
fi

mkdir -p "$HOME/.local/bin"
gcc -O2 -o "$HOME/.local/bin/gpu-watch" "$SRC/scripts/gpu-watch.c" -ldl
echo "gpu-watch installed to $HOME/.local/bin/gpu-watch"
