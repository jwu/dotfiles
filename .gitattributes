# Windows batch files must keep CRLF in the blob, not just in the working tree:
# cmd.exe's 'call :label' and 'goto :label' fail to find labels in an LF-only
# file, and bootstrap/windows.bat is documented to be fetched with curl, which
# gets the raw blob. 'text eol=crlf' would still store LF, so use -text.
*.bat -text
*.cmd -text

# pi prompt files must stay LF in the working tree too, not only in the blob:
# @johnnywu/pi-subagents parses agent frontmatter with a literal '---\n' check
# and never normalizes CRLF, so autocrlf=true would break every subagent
# definition on Windows. pi core normalizes it; that loader does not.
private_dot_pi/private_agent/**/*.md text eol=lf
