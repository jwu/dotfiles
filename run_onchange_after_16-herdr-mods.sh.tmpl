{{ if and (ne .chezmoi.os "windows") (not (index . "headless")) -}}
#!/bin/bash
# The sidebar mods for the Herdr app live in their own public repository
# (jwu/herdr-sidebar-mods), which is their source of truth; this script only
# installs the commit pinned in .chezmoidata.toml, which the Windows installer
# reads too. The layout that points at them is dot_config/herdr-app/layouts/.
# See docs/herdr.md.
set -euo pipefail

REV="{{ .herdr.sidebarModsRev }}"

MODS="$HOME/.config/herdr-app/mods"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# codeload serves the archive directly; github.com/.../archive/... only 302s to
# it, and that first hop is blocked on some networks. See docs/herdr.md.
curl -fsSL "https://codeload.github.com/jwu/herdr-sidebar-mods/tar.gz/$REV" -o "$TMP/mods.tar.gz"
tar -xzf "$TMP/mods.tar.gz" -C "$TMP"
SRC="$TMP/herdr-sidebar-mods-$REV/mods"

[ -f "$SRC/sidebar-spaces/main.js" ] && [ -f "$SRC/sidebar-agents/main.js" ]

mkdir -p "$MODS"
rm -rf "$MODS/sidebar-spaces" "$MODS/sidebar-agents"
cp -R "$SRC/sidebar-spaces" "$SRC/sidebar-agents" "$MODS/"

# Names these replaced before they moved to the shared repository.
rm -rf "$MODS/spaces-mine" "$MODS/agents-mine"

echo "installed sidebar mods at $REV"
{{ end -}}
