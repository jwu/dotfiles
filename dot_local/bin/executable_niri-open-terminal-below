#!/bin/bash
# Open Ghostty and stack it below the focused window in Niri.
#
# bash+jq rather than Python; docs/ghostty.md explains why the event stream is
# subscribed before spawning and why the jq filter ends with halt.

set -u

filter='
  .WindowOpenedOrChanged?.window
  | select(.app_id // "" | contains("ghostty"))
  | select(.id as $id | ($before | index($id)) == null)
  | .id, halt'

before=$(niri msg -j windows | jq -c '[.[].id]')

exec 3< <(niri msg -j event-stream 2> /dev/null |
  jq -r --unbuffered --argjson before "$before" "$filter")

niri msg action spawn -- ghostty

if read -r -t 10 -u 3 id; then
  niri msg action consume-or-expel-window-left --id "$id"
  exit 0
fi
exit 1
