#!/bin/bash
set -euo pipefail

# Lock the screen with hyprlock, falling back to swaylock. While the session stays
# locked, the monitors are powered off after SCREEN_OFF_TIMEOUT seconds of
# inactivity; the timer lives here, so it starts when the lock is taken rather
# than from the last input event. The lock style is a whole file, picked by output
# width, because hyprlock matches widgets to monitors by port name or EDID only
# and never by resolution. A dead locker is recovered with niri's Mod+Alt+L (see
# docs/lockscreen.md).

# Seconds the locked session may stay idle before the monitors go off.
SCREEN_OFF_TIMEOUT=60

# Width bands for the three styles, widest match wins. 1600 sits between a
# 1366x768 panel (medium) and a 1920x1080 or wider display (large); 900 sits
# between the 480x320 panel and a 1024x768 one.
FULL_MIN_WIDTH=1600
MEDIUM_MIN_WIDTH=900

if command -v hyprlock >/dev/null 2>&1; then
  # Default to the large style. Dropping to a smaller one requires a positive
  # sighting -- outputs were read and none is wide enough -- so a failed query
  # keeps the default instead of guessing.
  style="hyprlock-large.conf"
  detected="$(niri msg outputs 2>/dev/null | awk -v full="$FULL_MIN_WIDTH" -v medium="$MEDIUM_MIN_WIDTH" '
        /Logical size: / { seen = 1; split($3, d, "x"); w = d[1] + 0
                           if (w >= full)   hasFull   = 1
                           if (w >= medium) hasMedium = 1 }
        END { if (!seen) exit 1
              if (hasFull)        print "large"
              else if (hasMedium) print "medium"
              else                print "small" }' || true)"
  case "$detected" in
    large)  style="hyprlock-large.conf" ;;
    medium) style="hyprlock-medium.conf" ;;
    small)  style="hyprlock-small.conf" ;;
  esac
  locker=(hyprlock --config "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/$style")
else
  locker=(swaylock -f)
fi

# The screen-off timer lives exactly as long as the session is locked: swayidle
# re-arms after every activity, so the monitors go off again after each further
# idle period while the lock is held.
swayidle -w timeout "$SCREEN_OFF_TIMEOUT" "niri msg action power-off-monitors" &
idle_pid=$!

cleanup() {
  kill "$idle_pid" 2>/dev/null || true
  niri msg action power-on-monitors >/dev/null 2>&1 || true
}
trap cleanup EXIT

"${locker[@]}" || true
