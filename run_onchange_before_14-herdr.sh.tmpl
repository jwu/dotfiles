{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Herdr app (the newer window on herdr-core) ships no distro package: upstream's
# installer is a per-user download that needs neither root nor a TTY, which is
# what keeps it out of bootstrap/. On macOS its cask owns it, so there is
# nothing for this script to do there. The herdr 1 TUI daemon and Sheprd were
# uninstalled and are no longer managed. See docs/herdr.md.
set -uo pipefail

{{ if index . "headless" -}}
# A headless box has no window for herdr-app, and its installer would only add
# a FAILED step to every apply. See docs/ecs.md.
echo "headless; skipping herdr-app"
exit 0
{{ end }}

# The installer's target directory is not necessarily on PATH in the non-login
# shell chezmoi uses for run_ scripts.
export PATH="$HOME/.local/bin:$PATH"

FAILED_STEPS=()

step() {
  local name="$1"
  shift
  local rc=0
  echo ""
  echo ">>> $name"
  "$@" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "    ok"
  else
    FAILED_STEPS+=("$name")
    echo "    FAILED (exit $rc); continuing" >&2
  fi
}

summary() {
  echo ""
  echo "=========================================="
  if [ "${#FAILED_STEPS[@]}" -eq 0 ]; then
    echo ">>> All steps completed."
    return 0
  fi
  echo ">>> Finished with ${#FAILED_STEPS[@]} failed step(s):"
  local s
  for s in "${FAILED_STEPS[@]}"; do
    echo "      - $s"
  done
  echo ""
  echo "    Fix these, then clear the ledger and re-run:"
  echo "      chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
  return 1
}

echo ">>> herdr-app (upstream installer, root-free, per-user)"

# Herdr app draws herdr-core terminals. On macOS its cask owns it; on Linux
# upstream's installer is root-free too, so it lives here rather than in
# bootstrap/. See docs/herdr.md.
install_herdr_app() {
  if command -v herdr-app > /dev/null 2>&1; then
    echo "    herdr-app: $(herdr-app --version 2>/dev/null | head -1); upgrades come from the app"
    return 0
  fi
  sh -c "$(curl -fsSL https://releases.herdr.dev/app/install.sh)" || return 1
  command -v herdr-app > /dev/null 2>&1 || {
    echo "    herdr-app is still not on PATH after installing" >&2
    return 1
  }
  echo "    herdr-app: $(herdr-app --version 2>/dev/null | head -1)"
}

step "herdr-app" install_herdr_app
summary

{{ end -}}
