# style name or JSON path (default "auto")
# macOS loads this file from ~/Library/Preferences/glow, while the theme JSON
# stays at the XDG location and is referenced by absolute path.
style: "{{ .chezmoi.homeDir }}/.config/glow/one-dark.json"
# mouse support (TUI-mode only)
mouse: false
# use pager to display markdown
pager: false
# word-wrap at width
width: 80
# show all files, including hidden and ignored.
all: false
