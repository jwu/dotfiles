{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Fcitx5 / Rime runtime steps chezmoi cannot express as files: fetch the Rime Ice
# dictionaries, rebuild the compiled data, restart fcitx5.
#
# run_onchange_ plus the hashes below, so this only reruns when one of the five
# deployed files changed -- and `after`, because rime_deployer needs them on disk.
# Never clear the user directory: *.userdb holds the learned frequency data.
# See docs/rime/rime-config.md.
#
# profile:         {{ include "dot_config/fcitx5/private_profile" | sha256sum }}
# classicui.conf:  {{ include "dot_config/fcitx5/conf/classicui.conf" | sha256sum }}
# theme.conf:      {{ include "dot_local/share/fcitx5/themes/jwu/theme.conf" | sha256sum }}
# default.custom:  {{ include "dot_local/share/fcitx5/rime/default.custom.yaml" | sha256sum }}
# rime_ice.custom: {{ include "dot_local/share/fcitx5/rime/rime_ice.custom.yaml" | sha256sum }}
set -uo pipefail

FCITX_CONFIG_DIR="$HOME/.config/fcitx5"
FCITX_DATA_DIR="$HOME/.local/share/fcitx5"
RIME_DIR="$FCITX_DATA_DIR/rime"

if ! command -v fcitx5 &> /dev/null; then
  echo "fcitx5 is not installed; skipping the Rime steps." >&2
  exit 0
fi

# Rime keeps the compiled dictionaries in memory, so reloading fcitx5's config is
# not always enough to pick up a new build. Prefer a full restart, and fall back
# to fcitx5-remote -r when the DBus call is unavailable.
reload_fcitx5() {
  if command -v gdbus &> /dev/null; then
    if gdbus call --session --dest org.fcitx.Fcitx5 --object-path /controller \
      --method org.fcitx.Fcitx.Controller1.Restart &> /dev/null; then
      echo "    Restarted fcitx5 to load the new Rime build."
      return 0
    fi
  fi
  if command -v fcitx5-remote &> /dev/null; then
    if fcitx5-remote -r 2> /dev/null; then
      echo "    Reloaded fcitx5 config (restart fcitx5 if Rime still shows old words)."
      return 0
    fi
  fi
  echo "    Warning: could not restart fcitx5; restart it manually." >&2
  return 0
}

RIME_ICE_UPSTREAM="https://github.com/iDvel/rime-ice/releases/latest/download/full.zip"
# The NJU mirror is a cache that can lag weeks behind upstream, so it is only a
# fallback, and both sources are checked against the official digest below.
RIME_ICE_MIRROR="https://mirror.nju.edu.cn/github-release/iDvel/rime-ice/LatestRelease/full.zip"
RIME_ICE_API_PATH="repos/iDvel/rime-ice/releases/latest"

# Echo the official sha256 of full.zip, or nothing when it cannot be read. gh
# carries a 5000/h token, anonymous curl only 60/h. See docs/rime/rime-config.md.
rime_ice_digest() {
  local via_gh
  if command -v gh &> /dev/null; then
    via_gh="$(timeout 20 gh api "$RIME_ICE_API_PATH" \
      --jq '.assets[] | select(.name == "full.zip") | .digest' 2> /dev/null)" || true
    if [ -n "$via_gh" ]; then
      printf '%s\n' "${via_gh#sha256:}"
      return 0
    fi
  fi
  command -v python3 &> /dev/null || return 1
  local json
  json="$(curl -fsSL --max-time 15 "https://api.github.com/$RIME_ICE_API_PATH" 2> /dev/null)" || return 1
  printf '%s' "$json" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for asset in data.get("assets", []):
    if asset.get("name") == "full.zip":
        print(asset.get("digest", "").replace("sha256:", ""))
        break
' 2> /dev/null
}

install_rime_ice() {
  if [ -f "$RIME_DIR/rime_ice.schema.yaml" ]; then
    echo "    Rime Ice dictionaries already present."
    return 0
  fi
  local tmp digest url actual got
  tmp="$(mktemp -d)" || return 1
  digest="$(rime_ice_digest || true)"
  if [ -n "$digest" ]; then
    echo "    official sha256: $digest"
  else
    echo "    warning: could not read the official digest; installing unverified." >&2
  fi

  got=0
  for url in "$RIME_ICE_UPSTREAM" "$RIME_ICE_MIRROR"; do
    echo "    Downloading Rime Ice dictionaries (~16 MB) from $url"
    if ! curl -fL --retry 2 --connect-timeout 10 -o "$tmp/full.zip" "$url"; then
      echo "    Source unavailable: $url" >&2
      continue
    fi
    if [ -n "$digest" ]; then
      actual="$(sha256sum "$tmp/full.zip" | cut -d' ' -f1)"
      if [ "$actual" != "$digest" ]; then
        echo "    checksum mismatch (expected $digest, got $actual)" >&2
        continue
      fi
      echo "    sha256 verified: $actual"
    fi
    got=1
    break
  done
  if [ "$got" -ne 1 ]; then
    echo "    Error: no usable download source." >&2
    rm -rf "$tmp"
    return 1
  fi

  if command -v bsdtar &> /dev/null; then
    bsdtar -xf "$tmp/full.zip" -C "$RIME_DIR" || { rm -rf "$tmp"; return 1; }
  elif command -v unzip &> /dev/null; then
    unzip -q -o "$tmp/full.zip" -d "$RIME_DIR" || { rm -rf "$tmp"; return 1; }
  else
    echo "    Neither bsdtar nor unzip is available; install unzip to unpack the archive." >&2
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
  echo "    Rime Ice dictionaries installed."
}

mkdir -p "$FCITX_CONFIG_DIR/conf" "$FCITX_DATA_DIR/themes/jwu" "$RIME_DIR"

# Dictionaries first: the patches deployed by chezmoi are applied on top of them,
# so a future release that happens to ship a .custom.yaml cannot overwrite them.
if ! install_rime_ice; then
  echo "    Warning: Rime Ice dictionaries were not installed; see docs/rime/rime-config.md." >&2
fi

if command -v rime_deployer &> /dev/null && [ -f /usr/share/rime-data/default.yaml ]; then
  rime_deployer --build "$RIME_DIR" /usr/share/rime-data "$RIME_DIR/build"
fi

reload_fcitx5

echo "Fcitx5 Rime steps done (build/ and the user frequency data were left alone)."
{{ end -}}
