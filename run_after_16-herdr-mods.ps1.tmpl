{{ if eq .chezmoi.os "windows" -}}
#Requires -Version 5.1
# The sidebar mods for the Herdr app live in their own public repository
# (jwu/herdr-sidebar-mods); this script installs the ref in .chezmoidata.toml on
# every apply, so `main` keeps each machine on the latest push and a SHA pins
# one. The bash installer reads the same value. The layout that points at them
# is dot_config/herdr-app/layouts/. See docs/herdr.md.
$ErrorActionPreference = 'Stop'

$rev = '{{ .herdr.sidebarModsRev }}'
$mods = Join-Path $HOME '.config\herdr-app\mods'
$names = @('sidebar-spaces', 'sidebar-agents')
$installed = Join-Path $mods 'sidebar-agents\main.js'
$tmp = Join-Path ([System.IO.Path]::GetTempPath()) ('herdr-mods-' + [guid]::NewGuid().ToString('N'))

# Git for Windows puts GNU tar ahead of the inbox one on PATH, and GNU tar reads
# `C:\...` as a remote host. Pin both tools to System32. See docs/herdr.md.
$curl = Join-Path $env:SystemRoot 'System32\curl.exe'
$tar = Join-Path $env:SystemRoot 'System32\tar.exe'

# shared.json is the app's click state, so the layout cannot live in the source
# tree. Seed it once instead: without this a new machine stays on the built-in
# `main` and the modded sidebar looks missing. The marker keeps later applies
# from undoing a layout the user picked by hand. See docs/herdr.md.
$state = Join-Path $HOME '.local\state\herdr-sidebar-mods'
$mark = Join-Path $state 'layout-initialized'
$shared = Join-Path $HOME '.config\herdr-app\shared.json'
if (-not (Test-Path -LiteralPath $mark) -and (Test-Path -LiteralPath $shared)) {
  try {
    # Rewrite only this key: the file also carries click state, and a JSON round
    # trip through Windows PowerShell 5.1 can reshape it.
    $raw = [System.IO.File]::ReadAllText($shared)
    if ($raw -match '"layout"\s*:\s*"main"') {
      $raw = $raw -replace '"layout"\s*:\s*"main"', '"layout":"main-mine"'
      [System.IO.File]::WriteAllText($shared, $raw)
      # A running window keeps the layout in memory and would write `main` back.
      $app = Get-Command herdr-app -ErrorAction SilentlyContinue
      if ($app) {
        & $app.Source status *> $null
        if ($LASTEXITCODE -eq 0) { & $app.Source do layout.switch --name main-mine *> $null }
      }
    }
    New-Item -ItemType Directory -Force -Path $state | Out-Null
    New-Item -ItemType File -Force -Path $mark | Out-Null
  }
  catch {
    Write-Warning "herdr sidebar mods: could not seed the layout ($($_.Exception.Message))"
  }
}

# Which step failed decides whether an installed copy may stay: a network
# failure is waited out, a broken archive is not.
$stage = 'fetch'
try {
  New-Item -ItemType Directory -Force -Path $tmp | Out-Null
  $archive = Join-Path $tmp 'mods.tar.gz'

  # curl.exe and tar.exe ship with Windows 10 1803+; the bootstrap needs curl
  # anyway. Resolved from System32 above: PATH order is not reliable here.
  # codeload serves the archive directly; github.com/.../archive/... only 302s
  # to it, and that first hop is blocked on some networks. See docs/herdr.md.
  # This runs on every apply, so a slow network must not hold the apply for long.
  & $curl -fsSL --connect-timeout 10 --max-time 90 "https://codeload.github.com/jwu/herdr-sidebar-mods/tar.gz/$rev" -o $archive
  if ($LASTEXITCODE -ne 0) { throw "curl exited $LASTEXITCODE" }
  & $tar -xzf $archive -C $tmp
  if ($LASTEXITCODE -ne 0) { throw "tar exited $LASTEXITCODE" }

  $stage = 'archive'
  $src = Join-Path $tmp "herdr-sidebar-mods-$rev\mods"
  foreach ($name in $names) {
    if (-not (Test-Path -LiteralPath (Join-Path $src "$name\main.js"))) {
      throw "archive is missing $name/main.js"
    }
  }

  New-Item -ItemType Directory -Force -Path $mods | Out-Null
  foreach ($name in $names) {
    $dest = Join-Path $mods $name
    if (Test-Path -LiteralPath $dest) { Remove-Item -LiteralPath $dest -Recurse -Force }
    Copy-Item -LiteralPath (Join-Path $src $name) -Destination $dest -Recurse -Force
  }

  # Names these replaced before they moved to the shared repository.
  foreach ($name in @('spaces-mine', 'agents-mine')) {
    $old = Join-Path $mods $name
    if (Test-Path -LiteralPath $old) { Remove-Item -LiteralPath $old -Recurse -Force }
  }

  Write-Host "installed sidebar mods at $rev"
}
catch {
  # Offline: an installed copy stays as it is, and the apply still finishes.
  if ($stage -eq 'fetch' -and (Test-Path -LiteralPath $installed)) {
    Write-Warning "herdr sidebar mods: could not fetch $rev ($($_.Exception.Message)), keeping the installed copy"
    return
  }
  throw
}
finally {
  Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
}
{{ end -}}
