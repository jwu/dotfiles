color = "#800000"
duration = 0

[colors.bright]
black = "#5c6370"
blue = "#61afef"
cyan = "#56b6c2"
green = "#98c379"
magenta = "#c678dd"
red = "#e06c75"
white = "#abb2bf"
yellow = "#e5c07b"

[colors.cursor]
cursor = "CellForeground"
text = "CellBackground"

[colors.footer_bar]
background = "#282c34"
foreground = "#abb2bf"

[colors.hints.end]
background = "#282c34"
foreground = "#d19a66"

[colors.hints.start]
background = "#d19a66"
foreground = "#282c34"

[colors.line_indicator]
background = "None"
foreground = "None"

[colors.normal]
black = "#282c34"
blue = "#61afef"
cyan = "#56b6c2"
green = "#98c379"
magenta = "#c678dd"
red = "#e06c75"
white = "#abb2bf"
yellow = "#e5c07b"

[colors.primary]
background = "#282c34"
foreground = "#abb2bf"

[colors.search.focused_match]
background = "#d19a66"
foreground = "#282c34"

[colors.search.matches]
background = "#ebd09c"
foreground = "#282c34"

[colors.selection]
background = "#3b3f4c"
text = "CellForeground"

[colors.vi_mode_cursor]
cursor = "CellForeground"
text = "CellBackground"

[cursor]
blink_interval = 750
blink_timeout = 0
thickness = 0.15
unfocused_hollow = true
vi_mode_style = "None"
style = { blinking = "On", shape = "Block" }

[font]
size = 16.0
normal = { family = "FiraMono Nerd Font", style = "Regular" }
bold = { family = "FiraMono Nerd Font", style = "Bold" }
italic = { family = "FiraMono Nerd Font", style = "Italic" }
bold_italic = { family = "FiraMono Nerd Font", style = "Bold Italic" }
offset = { x = 0, y = 0 }

[keyboard]
bindings = [
  { key = "N", mods = "Command", action = "CreateNewWindow" },
  { key = "W", mods = "Command", action = "Quit" }
]

[mouse]
hide_when_typing = false

[scrolling]
history = 10000
multiplier = 3

[selection]
save_to_clipboard = true

[window]
decorations = "full"
dynamic_padding = true
dynamic_title = true
opacity = 0.95
startup_mode = "Windowed"
title = "Alacritty"
padding = { x = 0, y = 0}

[general]
live_config_reload = true
{{- else -}}
# ============================================================
# Alacritty Configuration
# ============================================================
# Mirrors ~/.config/ghostty/config.ghostty item by item; what Alacritty cannot
# express is listed at the end. See docs/alacritty.md.

[env]
# ghostty: term = xterm-256color
TERM = "xterm-256color"

# ------------------------------------------------------------
# Font
# ------------------------------------------------------------
[font]
# ghostty: font-size = 13.5
size = 13.5
normal = { family = "FiraMono Nerd Font", style = "Medium" }
bold = { family = "FiraMono Nerd Font", style = "Bold" }
italic = { family = "FiraMono Nerd Font", style = "Italic" }
bold_italic = { family = "FiraMono Nerd Font", style = "Bold Italic" }
# CJK fallback is fontconfig's job here, not a declared list.
# See docs/alacritty.md.

# ------------------------------------------------------------
# Colors (One Half Dark / OneDark)
# ------------------------------------------------------------
[colors]
# ghostty: bold-color = bright
draw_bold_text_with_bright_colors = true

[colors.primary]
background = "#282c34"
foreground = "#abb2bf"

# ghostty: palette 0-7
[colors.normal]
black = "#181a1f"
red = "#e86671"
green = "#98c379"
yellow = "#e5c07b"
blue = "#61afef"
magenta = "#c678dd"
cyan = "#56b6c2"
white = "#abb2bf"

# ghostty: palette 8-15
[colors.bright]
black = "#5c6370"
red = "#e06c75"
green = "#98c379"
yellow = "#e5c07b"
blue = "#61afef"
magenta = "#c678dd"
cyan = "#56b6c2"
white = "#abb2bf"

# ghostty: cursor-color / cursor-text
[colors.cursor]
cursor = "#dcdfe4"
text = "#282c34"

# ghostty: selection-background = 3b3f4c, selection-foreground = cell-foreground
[colors.selection]
background = "#3b3f4c"
text = "CellForeground"

# ghostty: search-background / search-foreground
[colors.search.matches]
background = "#ebd09c"
foreground = "#282c34"

# ghostty: search-selected-background / search-selected-foreground
[colors.search.focused_match]
background = "#d19a66"
foreground = "#282c34"

# Alacritty-only UI (search bar, hint labels, vi mode indicator); same theme.
[colors.footer_bar]
background = "#282c34"
foreground = "#abb2bf"

[colors.hints.start]
background = "#d19a66"
foreground = "#282c34"

[colors.hints.end]
background = "#282c34"
foreground = "#d19a66"

[colors.line_indicator]
foreground = "None"
background = "None"

[colors.vi_mode_cursor]
cursor = "CellForeground"
text = "CellBackground"

# ------------------------------------------------------------
# Cursor
# ------------------------------------------------------------
[cursor]
# ghostty: cursor-style = block, cursor-style-blink = true
style = { shape = "Block", blinking = "On" }
blink_interval = 750
# 0 = blink forever, as ghostty's cursor-style-blink does.
blink_timeout = 0
# ghostty does not hollow the cursor on blur; it dims the split instead.
unfocused_hollow = false

# ------------------------------------------------------------
# Window
# ------------------------------------------------------------
[window]
# ghostty: window-padding-x = 2 / window-padding-y = 2
padding = { x = 2, y = 2 }
# Narrows padding when undecorated or fullscreen, like padding-balance.
dynamic_padding = true
# ghostty: background-opacity = 1.0
opacity = 1.0
startup_mode = "Windowed"
# Dark CSD variant: without it the titlebar is light against #282c34.
decorations_theme_variant = "Dark"
# `decorations` is deliberately unset: it does nothing on Wayland, and setting it
# to "None" still yields a CSD frame. See docs/alacritty.md.

# ------------------------------------------------------------
# Scrollback
# ------------------------------------------------------------
[scrolling]
# ghostty: scrollback-limit = 10000000 bytes (~15,000 lines)
history = 15000
multiplier = 3

# ------------------------------------------------------------
# Mouse
# ------------------------------------------------------------
[mouse]
# ghostty: mouse-hide-while-typing = false
hide_when_typing = false

# ------------------------------------------------------------
# Clipboard
# ------------------------------------------------------------
[selection]
# ghostty: copy-on-select = clipboard
save_to_clipboard = true

# OSC 52 stays at Alacritty's default (OnlyCopy): remote writes allowed, reads
# not. ghostty's clipboard-read = ask has no equivalent here.

# ------------------------------------------------------------
# Bell
# ------------------------------------------------------------
# ghostty: bell-features = false
# Defaults already match ghostty's bell-features = false (no visual bell, no
# command), so there is no [bell] section.

# ------------------------------------------------------------
# Key Bindings
# ------------------------------------------------------------
[keyboard]
# ghostty: ctrl+v=paste_from_clipboard
#          ctrl+shift+v=unbind, which pi's pasteImage relies on
# Ctrl+Shift+V cannot pass through properly: no kitty keyboard protocol yet, so
# the application only receives Ctrl+V's encoding (0x16).
bindings = [
  { key = "V", mods = "Control", action = "Paste" },
  { key = "V", mods = "Control|Shift", chars = "\u0016" },
]

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
[general]
# Auto-reload, like ghostty.
live_config_reload = true

# ------------------------------------------------------------
# Known gaps against ghostty; not expressible in this file.
# Full list: docs/alacritty.md
# ------------------------------------------------------------
# No native splits or tabs, no CSS-customisable titlebar, no font fallback list,
# no font-thicken, no window-title-font-family, no shell-integration-features, no
# clipboard-trim-trailing-spaces, no kitty keyboard protocol.
#
# macOS-only keys (cmd+n / cmd+w / cmd+shift+arrow) do not apply here.
{{- end }}
