# 公共层：两台机器完全相同的部分。个人层（身份、机器特有的代理）刻意**不**由本仓库管理
# ——它含邮箱、人名和工作目录，属本机配置，手工维护在 ~/.gitconfig 里。
# git 先读这份 XDG 文件、再读 ~/.gitconfig，后者覆盖前者，所以个人层天然优先。

[init]
	defaultBranch = main
[core]
  pager = delta
	quotepath = false
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  light = false
  line-numbers = true
  side-by-side = true
  syntax-theme = OneHalfDark
[credential "https://github.com"]
	helper = 
	helper = !{{ .chezmoi.homeDir }}/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !{{ .chezmoi.homeDir }}/.local/bin/gh auth git-credential
[i18n]
	logOutputEncoding = utf-8
	commitEncoding = utf-8
