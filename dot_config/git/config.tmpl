# Shared layer: identical on every machine. The per-machine half (identity,
# proxy) is deliberately unmanaged -- it holds an email address, a name and a
# work directory layout. It lives in ~/.gitconfig, which git reads second and
# therefore overrides this file. See docs/design.md, the shared / per-machine split.

[init]
	defaultBranch = main
[core]
  pager = delta
	quotepath = false
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  light = false
  line-numbers = true
  side-by-side = true
  syntax-theme = OneHalfDark
# Linux runs the portable gh under ~/.local/bin, which is also the absolute path
# gh writes back when it refreshes this section; macOS (Homebrew) and Windows
# (portable under ~/bin) both have gh on PATH.
[credential "https://github.com"]
	helper = 
	helper = !{{ if eq .chezmoi.os "linux" }}{{ .chezmoi.homeDir }}/.local/bin/gh{{ else }}gh{{ end }} auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !{{ if eq .chezmoi.os "linux" }}{{ .chezmoi.homeDir }}/.local/bin/gh{{ else }}gh{{ end }} auth git-credential
[i18n]
	logOutputEncoding = utf-8
	commitEncoding = utf-8
