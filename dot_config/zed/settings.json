// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // theme and icon_theme below come from one-dark-pro and material-icon-theme.
  "text_rendering_mode": "platform_default",
  "auto_install_extensions": {
    "gdscript": true,
    "html": true,
    "lua": true,
    "material-icon-theme": true,
    "one-dark-pro": true,
    "toml": true,
    "windows-batch": true
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "soft_wrap": "prefer_line",
  "ui_font_family": "FiraMono Nerd Font",
  "ui_font_weight": 500,
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",
  "buffer_line_height": "standard",
  "tab_size": 2,
  "vim_mode": true,
  // The monospace entries cover macOS, Windows and Linux; the CJK entries keep
  // each platform from silently substituting a non-monospace face for CJK glyphs.
  // SemiBold mirrors ghostty's font-codepoint-map; see docs/fontconfig.md.
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Consolas",
    "Sarasa Mono SC SemiBold",
    "Noto Sans Mono CJK SC",
    "Microsoft YaHei",
    "Courier New",
    "monospace",
  ],
  "buffer_font_family": "FiraMono Nerd Font",
  // Ghostty renders FiraMono at its Medium face (font-style = Medium).
  "buffer_font_weight": 500,
  // Fira Mono ships no ligatures, but it does have a slashed zero.
  "buffer_font_features": {
    "zero": true,
  },
  "show_whitespaces": "none",
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  // Match Ghostty's font size so the embedded terminal reads the same.
  "terminal": {
    "font_size": 13.5,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
}
