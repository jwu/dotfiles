// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "soft_wrap": "prefer_line",
  "ui_font_family": "FiraMono Nerd Font",
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",
  "buffer_line_height": "standard",
  "tab_size": 2,
  "vim_mode": true,
  // Menlo/Monaco/Consolas cover macOS and Windows; the CJK entries keep Linux
  // from silently substituting a non-monospace face for CJK glyphs.
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Consolas",
    "Sarasa Mono SC",
    "Noto Sans Mono CJK SC",
    "Courier New",
    "monospace",
  ],
  "buffer_font_family": "FiraMono Nerd Font",
  "show_whitespaces": "none",
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
}
